{
  "contractVersion": "spatial-sr-data-v1",
  "jobName": "production_2x_template",
  "replayPass": "Standard",
  "expectedMap": "/Game/Maps/YourCaptureMap",
  "startFrame": 0,
  "endFrame": 299,
  "frameStep": 1,
