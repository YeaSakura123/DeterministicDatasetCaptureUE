  "startFrame": 0,
  "endFrame": 7,
  "frameStep": 1,
  "captureFrameRateNumerator": 30,
  "captureFrameRateDenominator": 1,
  "warmupFrames": 16,
  "hRResolution": {
    "x": 1920,
    "y": 1080
  },
  "lRResolution": {
    "x": 960,
    "y": 540
  },
  "lRMode": "NativeRender",
  "resizeFilter": "CubicMitchell",
  "bCaptureDepth": true,
  "bCaptureTemporalDiagnostics": true,
