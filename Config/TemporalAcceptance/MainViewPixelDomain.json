  "bBlockOnStreamingBeforeCapture": true,
  "streamingWaitSeconds": 60.0,
  "bEnableSemanticValidationFixture": true,
  "semanticMotionScenario": "Static",
  "bAutoQuit": true,
  "bRunSceneControlPreflight": true,
  "bRequireSceneControlPreflight": true,
  "bLockMaterialTimeToLogicalFrame": true,
  "sceneControlAllowedTickingActorClassPaths": [
    "/Script/Engine.DefaultPawn",
