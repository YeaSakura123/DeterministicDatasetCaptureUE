{
  "contractVersion": "spatial-sr-data-v1",
  "jobName": "main_view_pixel_domain",
  "expectedMap": "/Game/SRFormalV1/Gallery",
  "bUseDeterministicCameraTransform": true,
  "deterministicCameraLocationCm": {
    "x": 0,
    "y": 0,
    "z": 0
  },
  "deterministicCameraRotationDegrees": {
